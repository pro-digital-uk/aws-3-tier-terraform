# Copy to terraform.tfvars and adjust. terraform.tfvars is git-ignored.

aws_region       = "eu-west-2"
project_name     = "three-tier"
website_name     = "Three Tier"
environment_name = "mupando-dev"
team_name        = "platform"
environment      = "dev"

# COST WARNING: a NAT Gateway bills hourly plus per GB processed.
# Leave false unless the app tier needs outbound internet or Session Manager access.
enable_nat_gateway = false

instance_type        = "t3.micro"
force_destroy_bucket = true
